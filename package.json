{
  "name": "ai-for-developers-project-386",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "compile:contract": "tsp compile api --no-emit",
    "codegen:oas": "tsp compile api",
    "codegen:sdk": "npm run codegen:sdk -w apps/frontend",
    "codegen": "npm run codegen:oas && npm run codegen:sdk",
    "codegen:drift": "npm run codegen && git diff --quiet api/openapi.yaml apps/backend/src/generated apps/frontend/src/shared/api/sdk && echo codegen: drift clean || (echo 'codegen: emitted artifacts drifted from repo; запусти npm run codegen и закоммить diff.' && exit 1)",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@hey-api/openapi-ts": "0.99.0",
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/json-schema": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "@typespec/rest": "0.87.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.88.0",
    "turbo": "2.11.9",
    "typescript": "5.9.3"
  }
}
