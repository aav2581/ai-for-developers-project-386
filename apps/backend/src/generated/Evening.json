{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "Evening.json",
    "type": "object",
    "properties": {
        "date": {
            "type": "string"
        },
        "availableSlots": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
        },
        "slots": {
            "type": "array",
            "items": {
                "$ref": "Slot.json"
            }
        }
    },
    "required": [
        "date",
        "availableSlots",
        "slots"
    ]
}